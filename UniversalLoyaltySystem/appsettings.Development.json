{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LoyaltySystem;Trusted_Connection=True;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyForLoyaltySystem256BitsLong",
    "Issuer": "LoyaltySystemAPI",
    "Audience": "LoyaltySystemUsers",
    "AccessTokenExpiry": 1440,
    "RefreshTokenExpiry": 43200
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*"
}